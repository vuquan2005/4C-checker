{
  "name": "4c-checker",
  "version": "0.1.0",
  "description": "Automated CAD assignment checker and plagiarism detector for 4CHaUI",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "4c-checker": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "compile": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "cfb": "^1.2.2",
    "cheerio": "^1.2.0",
    "commander": "^13.1.0",
    "fast-xml-parser": "^5.11.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.6.0",
    "@types/node": "^24.18.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.0.7"
  }
}
